# Meta Model API (https://dev.meta.ai -> API keys)
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1

# Model IDs. Change here, never in code.
MODEL_SPARK=muse-spark-1.3
MODEL_WONDER=muse-wonder-1.0
MODEL_IMAGE=muse-image-1.0
MODEL_VOICE=muse-voice-transcribe-1.0
MODEL_SAM=sam-3.1

# 1 = serve recorded fixtures instead of calling the Model API (tests, offline demo)
OPL_FAKE_API=0
# 1 = call the Model API and save every response as a fixture
OPL_RECORD_FIXTURES=0

# Stop calling the Model API once this much has been spent (ledger in DATA_DIR)
SPEND_CAP_USD=25
SPEND_LEDGER_FILE=model_api_spend.jsonl
# Per-request timeout and attempts (429/500/503 are retried with backoff)
MODEL_API_TIMEOUT_S=60
MODEL_API_MAX_ATTEMPTS=4
# Longest wait honoured from a Retry-After header
MODEL_API_RETRY_AFTER_MAX_S=30
# Stable routing key for prompt caching
PROMPT_CACHE_NAME=orphan-parts
# Reasoning effort for label extraction: low is enough for reading a label
EXTRACT_REASONING_EFFORT=low
# Photos are downscaled to this many pixels on the long edge before upload
IMAGE_MAX_PX=1280
SEGMENT_MAX_PX=800
MAX_PHOTOS=4

# Uploaded images are deleted after this many hours
RETENTION_HOURS=24

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173

# Where uploads, the spend ledger and the SQLite database live
DATA_DIR=./data
# The inventory database file inside DATA_DIR
INVENTORY_DB_FILE=inventory.sqlite3

# Logging: json or text
LOG_FORMAT=json
LOG_LEVEL=INFO
