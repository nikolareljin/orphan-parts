# Meta Model API (https://dev.meta.ai -> API keys)
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1

# Model IDs. Change here, never in code.
MODEL_SPARK=muse-spark-1.3
MODEL_WONDER=muse-wonder-1.0
MODEL_IMAGE=muse-image-1.0
MODEL_VOICE=muse-voice-transcribe-1.0
MODEL_SAM=sam-3.1

# 1 = serve recorded fixtures instead of calling the Model API (tests, offline demo)
OPL_FAKE_API=0
# In live mode the key is probed once at startup; one that does not answer puts the service on
# recorded answers (said on /readyz). OPL_KEY_PROBE=0 skips the probe.
OPL_KEY_PROBE=1
# 1 = call the Model API and save every response as a fixture
OPL_RECORD_FIXTURES=0

# Stop calling the Model API once this much has been spent (ledger in DATA_DIR)
SPEND_CAP_USD=25
SPEND_LEDGER_FILE=model_api_spend.jsonl
# Per-request timeout and attempts (429/500/503 are retried with backoff)
MODEL_API_TIMEOUT_S=60
MODEL_API_MAX_ATTEMPTS=4
# Longest wait honoured from a Retry-After header
MODEL_API_RETRY_AFTER_MAX_S=30
# Stable routing key for prompt caching
PROMPT_CACHE_NAME=orphan-parts
# Reasoning effort for label extraction: low is enough for reading a label
EXTRACT_REASONING_EFFORT=low
# Photos are downscaled to this many pixels on the long edge before upload
IMAGE_MAX_PX=1280
SEGMENT_MAX_PX=800
MAX_PHOTOS=4

# Uploaded images are deleted after this many hours
RETENTION_HOURS=24
# What goes to the model is contrast-stretched and sharpened a little (EXTRACT_ENHANCE=0 turns it
# off); below EXTRACT_BLUR_THRESHOLD the reading carries a warning to retake the photo.
EXTRACT_ENHANCE=1
EXTRACT_BLUR_THRESHOLD=150

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173

# Where uploads, the spend ledger and the SQLite database live
DATA_DIR=./data
# The inventory database file inside DATA_DIR
INVENTORY_DB_FILE=inventory.sqlite3

# Measurement captures: least edge response around the marks, least reference span and
# image short side in pixels, and the marking precision the uncertainty assumes
MEASURE_MIN_SHARPNESS=150
MEASURE_MIN_REFERENCE_PX=80
MEASURE_MIN_IMAGE_PX=480
MEASURE_MARK_PX=1.5

# The demo gate. Empty = no gate, for a machine of your own. On any host other people can
# reach, set a code of at least 12 characters: every page needs it, a session lasts
# DEMO_SESSION_HOURS, and what spends is counted per visitor and per day. DEMO_PAUSED=1 refuses
# every call that spends; DEMO_COOKIE_SECURE=1 on an https host.
DEMO_ACCESS_CODE=
DEMO_SESSION_HOURS=12
DEMO_VISITOR_CALLS_PER_HOUR=20
DEMO_DAILY_CALLS=300
DEMO_CODE_ATTEMPTS=5
DEMO_REQUESTS_PER_MINUTE=120
DEMO_PAUSED=0
DEMO_COOKIE_SECURE=0

# Logging: json or text
LOG_FORMAT=json
LOG_LEVEL=INFO

# Deploying a published release (./dev deploy): the host the web app runs on and the directory
# there holding the two compose files and its own .env. Empty = no web deploy from here.
DEPLOY_HOST=
DEPLOY_PATH=
# Where the release images are; default: ghcr.io/<owner>/<name> from the origin remote
IMAGE_PREFIX=

# This machine's address for the phone (./dev phone); empty means the first address found
LAN_ADDRESS=

# ---------------------------------------------------------------------------------------------
# The hosted demo (./dev deploy hosted): the backend on Modal, the web app on Cloudflare Pages.
# Read only by `./dev deploy hosted` on this machine; the shell wins over these. The deploy
# workflow on GitHub reads the same names from the repository's Settings, Secrets and
# variables, Actions instead (DEMO_ACCESS_CODE, SPEND_CAP_USD and OPL_FAKE_API there, without
# the _HOSTED suffix). Never commit real values: .env is git-ignored, this file is not.
#
# Modal: modal.com, Settings, API tokens, New token (an ak- id and an as- secret, shown once).
# Or skip both and run `pipx install modal && modal setup` once: it keeps the login in
# ~/.modal.toml, which the modal command reads by itself.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Cloudflare: dash.cloudflare.com, My Profile, API Tokens, Create Token, Custom token with the
# one permission Account / Cloudflare Pages / Edit. The account id is on the Workers & Pages
# overview, right column.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# The Model API key the host uses: its own key with its own spend limit at dev.meta.ai.
# Empty = the host answers from recorded answers and spends nothing.
MODEL_API_KEY_DEMO=
# The host's access code (12 characters or more), cap and mode, kept apart from this machine's
DEMO_ACCESS_CODE_HOSTED=
SPEND_CAP_USD_HOSTED=20
OPL_FAKE_API_HOSTED=0
# The address browsers use for the web app, and the Pages project behind it
WEB_ORIGIN=https://orphan-parts.pages.dev
PAGES_PROJECT=orphan-parts
# Empty = the URL the backend deploy prints; set it only for a web-only deploy
API_URL=
# 1 keeps the backend warm (no cold start while judging), 0 lets it sleep
OPL_MIN_CONTAINERS=1
# true lets the deploy workflow run (set it last, once everything above is filled);
# the plan repo's ./set-secrets --from-env copies this section to the repository settings
HOSTED_DEPLOY=

# ---------------------------------------------------------------------------------------------
# A second model route, planned and not yet read by any code (docs/project/next.md). The keys
# stay in a password manager until that stage lands; these are the names it will use.
# Baseten: app.baseten.co, Settings, API keys. Fireworks: app.fireworks.ai, Settings, API Keys.
BASETEN_API_KEY=
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
SPARK_OPEN_ENABLED=0
# baseten or fireworks
SPARK_OPEN_PROVIDER=
# the model id from the provider's catalog
SPARK_OPEN_MODEL=
