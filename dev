#!/usr/bin/env bash
# dev: one entry point for running, testing and building Orphan Parts Lens.
#
# Usage: ./dev <command> [options]
#
# Commands:
#   setup [--check] [--android]
#                      check tools, create .env from .env.example if missing; --android installs
#                      what the app needs (a JDK, the Android command-line tools and packages);
#                      --check changes nothing
#   phone [--release]  build the app, install it on the connected phone, launch it, and print
#                      the pairing code to scan (the stack must be up)
#   up [--native] [--build] [--with-glimmer]
#                      start the stack (Docker by default; --native = local venv + nvm)
#   down               stop the Docker stack
#   status             show running services and health
#   logs [service]     follow Docker logs
#   test [backend|frontend|scripts]
#                      run the full check suite (default: all three)
#   check-api          confirm the Model API key, the active mode and the spend ledger
#   e2e                Playwright against the dev stack in fixture mode (E2E_KEEP=1 leaves it up)
#   lint               ruff, mypy, eslint, tsc
#   fmt                ruff format, eslint --fix
#   docs               serve the docs site at :8001 with live reload
#   docs-build         build the docs site into site/
#   build              build the production images
#   version <x.y.z>    set the version in VERSION and every manifest, start the changelog section
#   release [--dry-run]
#                      tag VERSION on main and push the tag (the repository admin's command);
#                      the tag starts the release workflow
#   deploy [web|android|all] [--version x.y.z]
#                      put a published release on the host, and build the APK when there is one
#   android <build|test|release|install|smoke>
#                      the app: unit tests, the APKs, an install, a smoke run on a device
#   demo [--keep]      reset the inventory and load demo/set.yaml in fixture mode (recorded
#                      answers, nothing spent); --keep adds to what is there
#   record-fixtures [--keep]
#                      reset the inventory and load the set once with the key from .env,
#                      keeping every model answer as a fixture (OPL_RECORD_FIXTURES=1);
#                      spends credits once; --keep adds to what is there
#   demo-scrub <dir>   re-encode raw photos from <dir> into demo/photos/ without metadata,
#                      WAV notes copied into demo/notes/
#   shell <service>    open a shell in a running service
#   help               this text
#
# Flags: -v/--verbose, -d/--debug (set -x)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib/lib.sh
. "$ROOT/scripts/lib/lib.sh"

BACKEND="$ROOT/backend"
FRONTEND="$ROOT/frontend"
BACKEND_PORT="${BACKEND_PORT:-8000}"
FRONTEND_PORT="${FRONTEND_PORT:-5173}"
DOCS_PORT="${DOCS_PORT:-8001}"

parse_common_args "${BASH_SOURCE[0]}" "$@"
set -- "${ARGS[@]+"${ARGS[@]}"}"
cmd="${1:-help}"
[[ $# -gt 0 ]] && shift

need_env_file() {
  if [[ ! -f "$ROOT/.env" ]]; then
    log_warn ".env not found; copying .env.example (set MODEL_API_KEY or OPL_FAKE_API=1)"
    cp "$ROOT/.env.example" "$ROOT/.env"
  fi
}

cmd_setup() {
  local check=0 android=0
  for arg in "$@"; do
    case "$arg" in
      --check) check=1 ;;
      --android) android=1 ;;
      *) die "usage: ./dev setup [--check] [--android]" ;;
    esac
  done
  log_info "platform: $(os_name)"
  if docker_running; then
    log_ok "docker: $(docker --version | sed 's/,.*//')"
    log_ok "compose: $(compose_cmd)"
  else
    log_warn "docker is not running; install Docker Desktop (macOS, Windows) or Docker Engine (Linux); only the native path (./dev up --native) works without it"
  fi
  if py_find >/dev/null; then log_ok "python: $(py_find)"; else log_warn "python 3.12 not found (needed for --native only)"; fi
  if has_cmd node; then log_ok "node: $(node --version)"; else log_warn "node not found (needed for --native only; nvm install 24)"; fi
  if [[ $android -eq 1 && $check -eq 0 ]]; then
    bash "$ROOT/scripts/setup-android.sh"
  else
    bash "$ROOT/scripts/setup-android.sh" --check || log_warn "the app cannot be built yet: ./dev setup --android installs what is missing"
  fi
  [[ $check -eq 1 ]] || need_env_file
  log_ok "ready. next: ./dev up, then ./dev phone"
}

# The app onto the connected phone, launched, and the pairing code printed: the phone talks to
# the web app's origin on this machine's address (the web app proxies the API), with a session
# of its own when the demo is gated.
cmd_phone() {
  local release=0
  [[ "${1:-}" == "--release" ]] && release=1
  docker_running || die "docker is not running"
  curl -fsS -m 5 "http://localhost:$BACKEND_PORT/healthz" >/dev/null 2>&1 || die "the stack is not up (or not answering on :$BACKEND_PORT): ./dev up first"
  # one device for every step: picked here once, so several phones are asked about once
  local picked
  picked="$(bash "$ROOT/scripts/android.sh" serial 2>/dev/null || true)"
  [[ -z "$picked" ]] || export ANDROID_SERIAL="$picked"
  if [[ $release -eq 1 ]]; then
    bash "$ROOT/scripts/android.sh" release
    local apk
    apk="$(find "$ROOT/android/app/build/outputs/apk/release" -name '*.apk' | head -1 || true)"
    bash "$ROOT/scripts/android.sh" install-file "$apk"
  else
    bash "$ROOT/scripts/android.sh" build
    bash "$ROOT/scripts/android.sh" install
  fi
  bash "$ROOT/scripts/android.sh" launch
  local address
  address="$(lan_address)"
  [[ -n "$address" ]] || die "could not tell this machine's address on the network; set LAN_ADDRESS"
  if [[ "$(os_name)" == wsl ]]; then
    log_warn "under WSL this is the WSL address; the phone needs the Windows host's address on the Wi-Fi, so set LAN_ADDRESS to that and forward port $FRONTEND_PORT"
  fi
  api_mode_or_fixture
  log_info "scan this with the app (Backend tab, Scan to pair):"
  compose run --rm --no-deps -T backend python -m app.pairing --origin "http://$address:$FRONTEND_PORT"
}

# This machine's address on the local network, for the phone to reach the web app.
lan_address() {
  if [[ -n "${LAN_ADDRESS:-}" ]]; then printf '%s\n' "$LAN_ADDRESS"; return; fi
  if is_macos; then ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || true
  else hostname -I 2>/dev/null | awk '{print $1}' || true; fi
}

# Without a key the backend refuses to start, by design. Starting the stack to look at it should
# still work, so with an empty MODEL_API_KEY and fixture mode not asked for, fixture mode it is.
api_mode_or_fixture() {
  local fake="${OPL_FAKE_API:-$(env_get OPL_FAKE_API "$ROOT/.env")}"
  [[ "$fake" == "1" ]] && return 0
  if [[ -z "${MODEL_API_KEY:-$(env_get MODEL_API_KEY "$ROOT/.env")}" ]]; then
    log_warn "MODEL_API_KEY is empty in .env; starting in fixture mode (recorded answers, no credits)"
    export OPL_FAKE_API=1
  fi
}

cmd_up() {
  local native=0 build=0 profiles=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --native) native=1 ;;
      --build) build=1 ;;
      --with-glimmer) profiles="--profile openweight" ;;
      *) die "unknown option for up: $1" ;;
    esac
    shift
  done
  need_env_file
  api_mode_or_fixture
  if [[ $native -eq 1 ]]; then
    up_native
    return
  fi
  docker_running || die "docker is not running"
  ports_check "$BACKEND_PORT" "$FRONTEND_PORT" || die "free the ports above or set BACKEND_PORT/FRONTEND_PORT"
  local args=(up -d)
  [[ $build -eq 1 ]] && args+=(--build)
  # shellcheck disable=SC2086
  compose $profiles "${args[@]}" || { compose logs --tail 20 backend; die "the stack did not start; the backend log is above"; }
  wait_http "http://localhost:$BACKEND_PORT/healthz" 90 || { compose logs --tail 20 backend; die "backend did not become healthy"; }
  log_ok "api  http://localhost:$BACKEND_PORT/docs"
  log_ok "web  http://localhost:$FRONTEND_PORT"
}

up_native() {
  venv_ensure "$BACKEND"
  node_ensure "$FRONTEND"
  env_load "$ROOT/.env"
  ports_check "$BACKEND_PORT" "$FRONTEND_PORT" || die "ports in use"
  kill_group_on_exit
  export DATA_DIR="${DATA_DIR:-$ROOT/data}"
  venv_run "$BACKEND" uvicorn app.main:app --reload --port "$BACKEND_PORT" &
  VITE_API_URL="http://localhost:$BACKEND_PORT" node_run "$FRONTEND" npm run dev -- --port "$FRONTEND_PORT" &
  log_ok "api  http://localhost:$BACKEND_PORT/docs"
  log_ok "web  http://localhost:$FRONTEND_PORT"
  wait
}

cmd_down() { compose --profile openweight --profile docs down --remove-orphans "$@"; }

cmd_status() {
  compose ps
  if curl -fsS "http://localhost:$BACKEND_PORT/readyz" 2>/dev/null; then echo; else log_warn "backend not answering on :$BACKEND_PORT"; fi
}

cmd_logs() { compose logs -f "$@"; }

cmd_test() {
  local what="${1:-all}" failed=0
  case "$what" in
    all|scripts) test_scripts || failed=1 ;;
  esac
  case "$what" in
    all|backend) test_backend || failed=1 ;;
  esac
  case "$what" in
    all|frontend) test_frontend || failed=1 ;;
  esac
  [[ $failed -eq 0 ]] || die "some checks failed"
  log_ok "all checks passed"
}

test_scripts() {
  log_info "scripts: bash helper tests"
  bash "$ROOT/scripts/tests/run.sh"
}

test_backend() {
  [[ -d "$BACKEND" ]] || { log_warn "backend: not in this tree yet, skipped"; return 0; }
  log_info "backend: ruff, mypy, pytest"
  run_in backend sh -c 'ruff check . && ruff format --check . && mypy app && pytest -q'
}

test_frontend() {
  [[ -d "$FRONTEND" ]] || { log_warn "frontend: not in this tree yet, skipped"; return 0; }
  log_info "frontend: eslint, tsc, vitest, build"
  run_in frontend sh -c 'npm ci --no-audit --no-fund --loglevel=error && npm run lint && npm run typecheck && npm test -- --run && npm run build'
}

# run_in <service> <cmd...>: inside the Docker service, or natively when NATIVE=1.
run_in() {
  local svc="$1"; shift
  if [[ "${NATIVE:-0}" == "1" ]]; then
    case "$svc" in
      backend) venv_ensure "$BACKEND"; venv_run "$BACKEND" "$@" ;;
      frontend) node_ensure "$FRONTEND"; node_run "$FRONTEND" "$@" ;;
    esac
  else
    docker_running || die "docker is not running (set NATIVE=1 to run without Docker)"
    compose run --rm --no-deps -e OPL_FAKE_API=1 "$svc" "$@"
  fi
}

# Runs with the real .env (not fixture mode): one GET /models, no tokens spent.
cmd_check_api() {
  need_env_file
  if [[ "${NATIVE:-0}" == "1" ]]; then
    venv_ensure "$BACKEND"
    env_load "$ROOT/.env"
    venv_run "$BACKEND" python -m app.model_api check
  else
    docker_running || die "docker is not running (set NATIVE=1 to run without Docker)"
    compose run --rm --no-deps backend python -m app.model_api check
  fi
}

# Browser checks against the dev stack in fixture mode: no key, no credits. Playwright runs
# in its own image sharing the frontend container's network, as the host user so every file it
# writes under e2e/ is yours.
cmd_e2e() {
  need_env_file
  docker_running || die "docker is not running"
  export OPL_FAKE_API=1
  # the browser checks go through the demo gate, with a code of their own unless the shell sets one;
  # the allowances are for people, not for six workers on one address, so they are wide here
  export DEMO_ACCESS_CODE="${DEMO_ACCESS_CODE:-e2e-demo-access-code}"
  export DEMO_REQUESTS_PER_MINUTE=100000 DEMO_VISITOR_CALLS_PER_HOUR=100000 DEMO_DAILY_CALLS=1000000
  export DOCKER_UID DOCKER_GID
  DOCKER_UID="$(id -u)"
  DOCKER_GID="$(id -g)"
  compose up -d backend frontend
  wait_http "http://localhost:$BACKEND_PORT/readyz" 90 || { compose logs backend; die "backend not ready"; }
  wait_http "http://localhost:$FRONTEND_PORT" 180 || { compose logs frontend; die "frontend did not start"; }
  local rc=0
  compose --profile e2e run --rm e2e || rc=$?
  [[ "${E2E_KEEP:-0}" == "1" ]] || compose --profile e2e down --remove-orphans
  [[ $rc -eq 0 ]] || die "end-to-end checks failed (results under e2e/test-results)"
  log_ok "end-to-end checks passed"
}

cmd_lint() {
  run_in backend sh -c 'ruff check . && ruff format --check . && mypy app'
  run_in frontend sh -c 'npm ci --no-audit --no-fund --loglevel=error && npm run lint && npm run typecheck'
}

cmd_fmt() {
  run_in backend sh -c 'ruff format . && ruff check --fix .'
  run_in frontend sh -c 'npm ci --no-audit --no-fund --loglevel=error && npm run lint -- --fix'
}

cmd_docs() {
  docker_running || die "docker is not running"
  compose --profile docs up docs
}

cmd_docs_build() {
  docker_running || die "docker is not running"
  compose run --rm --no-deps -e OPL_FAKE_API=1 backend python -m app.openapi_export > "$ROOT/docs/reference/openapi.json"
  compose --profile docs run --rm docs build --strict
  log_ok "site/ is ready"
}

cmd_build() {
  COMPOSE_EXTRA_FILES="-f docker-compose.prod.yml" compose build "$@"
}

cmd_version() {
  local v="${1:-}"
  [[ "$v" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] \
    || die "usage: ./dev version <major.minor.patch>, no leading zeros, no prefix"
  local today
  today="$(date +%Y-%m-%d)"
  # sed -i needs a suffix on macOS; drop the backups afterwards
  printf '%s\n' "$v" > "$ROOT/VERSION"
  sed -i.bak "s/^version = \".*\"/version = \"$v\"/" "$BACKEND/pyproject.toml"
  sed -i.bak "s/^__version__ = \".*\"/__version__ = \"$v\"/" "$BACKEND/app/__init__.py"
  sed -i.bak "s/^  \"version\": \"[0-9.]*\"/  \"version\": \"$v\"/" "$FRONTEND/package.json"
  awk -v v="$v" -v d="$today" '{print} /^## Unreleased$/{print ""; print "## " v " - " d}' "$ROOT/CHANGELOG.md" > "$ROOT/CHANGELOG.md.new"
  mv "$ROOT/CHANGELOG.md.new" "$ROOT/CHANGELOG.md"
  rm -f "$BACKEND/pyproject.toml.bak" "$BACKEND/app/__init__.py.bak" "$FRONTEND/package.json.bak"
  run_in frontend sh -c 'npm install --package-lock-only --no-audit --no-fund --loglevel=error' >/dev/null
  log_ok "version $v set in VERSION, pyproject.toml, app/__init__.py, package.json, package-lock.json and CHANGELOG.md"
  echo "  move the Unreleased notes under the new heading, then:"
  echo "  git switch -c release/$v && git add -A && git commit -m \"chore: release $v\" && git push -u origin release/$v"
  echo "  open the PR; once it is merged the merge commit is tagged $v and the release published"
  echo "  (or, on main after the merge: ./dev release, then ./dev deploy)"
}

cmd_release() { bash "$ROOT/scripts/release.sh" "$@"; }

cmd_deploy() { bash "$ROOT/scripts/deploy.sh" "$@"; }

cmd_android() { bash "$ROOT/scripts/android.sh" "$@"; }

# The set is loaded through the backend's own code against the stack's data volume, so the
# backend is stopped for the reset and started again after; nothing else is touched.
# The loaders have the data volume to themselves: a running backend is stopped for the run and
# started again however the run ends, so a failed load does not leave the stack down.
_backend_was_up=0
_start_backend_again() {
  [[ $_backend_was_up -eq 0 ]] || compose start backend >/dev/null
}
stop_backend_for_run() {
  compose ps --status running backend 2>/dev/null | grep -q backend && _backend_was_up=1
  if [[ $_backend_was_up -eq 1 ]]; then
    compose stop backend >/dev/null
    on_exit _start_backend_again
  fi
}

cmd_demo() {
  local reset="--reset"
  [[ "${1:-}" == "--keep" ]] && reset=""
  docker_running || die "docker is not running"
  stop_backend_for_run
  # shellcheck disable=SC2086
  compose run --rm --no-deps -e OPL_FAKE_API=1 backend python -m app.demo load --set /demo/set.yaml $reset
  log_ok "demo set loaded"
}

cmd_record_fixtures() {
  local reset="--reset"
  [[ "${1:-}" == "--keep" ]] && reset=""
  need_env_file
  docker_running || die "docker is not running"
  grep -Eq '^MODEL_API_KEY=.+' "$ROOT/.env" || die "record-fixtures needs MODEL_API_KEY in .env"
  stop_backend_for_run
  # shellcheck disable=SC2086
  compose run --rm --no-deps -e OPL_FAKE_API=0 -e OPL_RECORD_FIXTURES=1 backend python -m app.demo record --set /demo/set.yaml $reset
  log_ok "fixtures recorded under backend/tests/fixtures/api; review and commit them"
}

cmd_demo_scrub() {
  local raw="${1:?usage: ./dev demo-scrub <raw dir>}"
  [[ -d "$raw" ]] || die "demo-scrub: $raw is not a directory"
  docker_running || die "docker is not running"
  compose run --rm --no-deps -e OPL_FAKE_API=1 -v "$(cd "$raw" && pwd):/raw:ro" backend python -m app.demo scrub /raw --out /demo/photos --notes /demo/notes
  log_ok "scrubbed copies under demo/photos, WAV notes under demo/notes"
}

cmd_shell() {
  local svc="${1:-backend}"
  compose exec "$svc" sh
}

case "$cmd" in
  setup) cmd_setup "$@" ;;
  up) cmd_up "$@" ;;
  down) cmd_down "$@" ;;
  status) cmd_status "$@" ;;
  logs) cmd_logs "$@" ;;
  test) cmd_test "$@" ;;
  check-api) cmd_check_api "$@" ;;
  e2e) cmd_e2e "$@" ;;
  lint) cmd_lint "$@" ;;
  fmt) cmd_fmt "$@" ;;
  docs) cmd_docs "$@" ;;
  docs-build) cmd_docs_build "$@" ;;
  build) cmd_build "$@" ;;
  version) cmd_version "$@" ;;
  release) cmd_release "$@" ;;
  deploy) cmd_deploy "$@" ;;
  android) cmd_android "$@" ;;
  phone) cmd_phone "$@" ;;
  demo) cmd_demo "$@" ;;
  record-fixtures) cmd_record_fixtures "$@" ;;
  demo-scrub) cmd_demo_scrub "$@" ;;
  shell) cmd_shell "$@" ;;
  help|-h|--help) script_help "${BASH_SOURCE[0]}" ;;
  *) die "unknown command: $cmd (try ./dev help)" 2 ;;
esac
